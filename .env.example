# ============================================================
# Reply Botz Helpdesk - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://postgres:helpdesk_dev_password@localhost:5432/helpdesk
DB_PASSWORD=helpdesk_dev_password

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password  # Uncomment for production

# ============================================================
# Qdrant (Vector Store)
# ============================================================
QDRANT_URL=http://localhost:6333

# ============================================================
# App Configuration
# ============================================================
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============================================================
# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_ACCESS_SECRET=CHANGE_ME_generate_256_bit_secret_here
JWT_REFRESH_SECRET=CHANGE_ME_generate_different_256_bit_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============================================================
# FERPA Encryption Key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Keep this secret and back it up securely!
# Losing this key means losing access to all encrypted student data
# ============================================================
ENCRYPTION_KEY=CHANGE_ME_generate_64_hex_chars_32_bytes_here

# ============================================================
# OAuth2 (Google)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ============================================================
# OAuth2 (Microsoft)
# ============================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/auth/microsoft/callback

# ============================================================
# AI Providers
# ============================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...
PERPLEXITY_API_KEY=pplx-...
OPENROUTER_API_KEY=sk-or-...

# ============================================================
# Email (SMTP)
# ============================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourhelpdeskdomain.com

# ============================================================
# Voice (Twilio - Phase 3)
# ============================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ============================================================
# LMS OAuth2 Credentials
# ============================================================
# GOOGLE_CLASSROOM_CLIENT_ID=
# GOOGLE_CLASSROOM_CLIENT_SECRET=
# CANVAS_API_KEY=
# SCHOOLOGY_CLIENT_ID=
# SCHOOLOGY_CLIENT_SECRET=

# ============================================================
# WhatsApp (Phase 3)
# ============================================================
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=

# ============================================================
# Monitoring
# ============================================================
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# Next.js (Frontend)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=Reply Botz Helpdesk
NEXT_PUBLIC_APP_URL=http://localhost:3000
