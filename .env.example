# ===========================================
# Reply Botz HD - Environment Configuration
# ===========================================
# Copy to `.env` (Docker Compose interpolates its ${VAR} values from .env).

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=replybotz.localhost

# Database (PostgreSQL)
DATABASE_URL=postgresql://replybotz:changeme@localhost:5432/replybotz
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://:changeme@localhost:6379
REDIS_PASSWORD=changeme

# Auth (JWT)
JWT_SECRET=generate-a-64-char-random-string-with-openssl-rand-base64-48
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password hashing (Argon2)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# MFA (TOTP)
MFA_ISSUER=ReplyBotzHD

# Encryption (AES-256-GCM for API keys and integration configs)
ENCRYPTION_KEY=generate-a-32-byte-hex-string-with-openssl-rand-hex-32

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=changeme
MEILI_ENV=development

# Monitoring
GRAFANA_PASSWORD=changeme

# Logging
LOG_LEVEL=debug

# Tenant resolution mode: subdomain | header | path
TENANT_RESOLUTION_MODE=subdomain

# Seed admin (optional — defaults to admin@replybotz.com / Admin@123456)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-to-something-strong
